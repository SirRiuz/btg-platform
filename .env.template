# ──────────────────────────────────────────────────────────────────────────
#  .env.template — copy to .env (which is gitignored) and fill in values.
#  NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────

# Frontend
FRONTEND_SERVER_PORT=3000

# Backend
DEBUG=True
SERVER_PORT=8000
# Comma-separated list of origins allowed by the CORS middleware. Add
# every frontend origin that will call the API. The browser sends an
# `Origin` header per request and FastAPI matches it against this list;
# unknown origins get a preflight 400 / blocked fetch in the browser.
# Examples (uncomment / extend as needed):
#   - http://localhost:3000               local dev
#   - https://your-frontend.example.com   production frontend
ALLOWER_CORS_ORIGINS="http://localhost:3000"

# Root log level. DEBUG also turns boto3/botocore loggers up — every AWS
# request/response gets dumped, including signing parameters. Use only
# while actively debugging; never in production.
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────
#  MongoDB
# ──────────────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_DB_NAME=soptest
MONGO_PORT=27017
# Note: docker-compose builds the final MONGO_URI from the four values above.

# ──────────────────────────────────────────────────────────────────────────
#  Auth — JWT
# ──────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
# Empty = tokens never expire (suitable for development).
# In production set to an integer (minutes).
JWT_EXPIRATION_MINUTES=

# Auth — bcrypt cost factor.
BCRYPT_ROUNDS=12

# ──────────────────────────────────────────────────────────────────────────
#  Notifications
# ──────────────────────────────────────────────────────────────────────────

# Master kill switch — set to false to silence the whole pipeline without
# removing the integration code (useful during incidents / load tests).
NOTIFICATIONS_ENABLED=true

# 'log' (default, dev-friendly: logs the message instead of calling AWS)
# or 'aws' (real SES + SNS in the configured region).
NOTIFICATIONS_PROVIDER=log

# AWS region for both SES and SNS. SES requires the from-email to be a
# VERIFIED identity in this region.
AWS_REGION=us-east-1

# SES verified-identity used as the From: address.
SES_FROM_EMAIL=noreply@yourdomain.com

# Alphanumeric SMS sender id. Up to 11 alphanumeric chars. Honored in
# most of LATAM/Europe/Asia; silently replaced by a long number in
# USA/Canada (AWS does the swap server-side). Set this to your brand.
SNS_SENDER_ID=FundsApp

# Default region (ISO-3166 alpha-2) used to interpret phone numbers
# entered without a country prefix.
PHONE_DEFAULT_REGION=CO

# ──────────────────────────────────────────────────────────────────────────
#  AWS credentials  ── LOCAL DEV ONLY
# ──────────────────────────────────────────────────────────────────────────
#  REQUIRED when NOTIFICATIONS_PROVIDER=aws AND the app is NOT running in
#  Lambda. In Lambda production deploys, OMIT both and rely on the IAM
#  execution role assigned to the function — that's the secure default.
#
#  These values are SECRETS:
#    • Never commit them.
#    • Never paste them into a chat / screenshot / ticket.
#    • In real production, store them in AWS Secrets Manager or SSM
#      Parameter Store; never as plain env vars.
#
#  The placeholders below intentionally do NOT look like real keys —
#  if you see "AKIA_REPLACE_..." in a deploy, the env wasn't filled in.
# ──────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA_REPLACE_WITH_YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_KEY
